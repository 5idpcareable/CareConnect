generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String
  dateOfBirth  String
  postcode     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles              UserRole[]
  sessions           Session[]
  carerProfile       CarerProfile?
  assessmentAttempts AssessmentAttempt[]

  createdQuestionnaires Questionnaire[] @relation("QuestionnaireCreatedBy")
  updatedQuestionnaires Questionnaire[] @relation("QuestionnaireUpdatedBy")

  createdAssessmentDomains AssessmentDomain[] @relation("AssessmentDomainCreatedBy")
  updatedAssessmentDomains AssessmentDomain[] @relation("AssessmentDomainUpdatedBy")

  createdAssessmentQuestions AssessmentQuestion[] @relation("AssessmentQuestionCreatedBy")
  updatedAssessmentQuestions AssessmentQuestion[] @relation("AssessmentQuestionUpdatedBy")
}

model Role {
  id   Int    @id
  name String @unique

  users UserRole[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CarerProfile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  workStatus          String?
  lookingForWork      String?
  appliedRecently     String?
  interestedIndustry  String?
  speaksOtherLanguage String?
  language            String?
  referralSource      String?
  reasonForJoining    String?
  careRecipient       String?
  careRecipientAge    String?
  careCondition       String?
  careDuration        String?
  termsAccepted       Boolean @default(false)
  researchConsent     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model AdminAccessRequest {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  phone        String
  dateOfBirth  String
  postcode     String
  passwordHash String
  status       String    @default("PENDING")
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Questionnaire {
  id          String   @id @default(cuid())
  title       String
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  updatedById String?

  createdBy User? @relation("QuestionnaireCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("QuestionnaireUpdatedBy", fields: [updatedById], references: [id])

  domains  AssessmentDomain[]
  attempts AssessmentAttempt[]
}

model AssessmentDomain {
  id              String   @id @default(cuid())
  questionnaireId String
  title           String
  description     String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdById String?
  updatedById String?

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("AssessmentDomainCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?         @relation("AssessmentDomainUpdatedBy", fields: [updatedById], references: [id])

  questions AssessmentQuestion[]
  responses AssessmentResponse[]
}

model AssessmentQuestion {
  id         String    @id @default(cuid())
  domainId   String
  prompt     String
  helpText   String?
  type       String    @default("LIKERT_1_5")
  order      Int       @default(0)
  isRequired Boolean   @default(true)
  isVisible  Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdById String?
  updatedById String?

  domain    AssessmentDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("AssessmentQuestionCreatedBy", fields: [createdById], references: [id])
  updatedBy User?            @relation("AssessmentQuestionUpdatedBy", fields: [updatedById], references: [id])

  responses AssessmentResponse[]
}

model AssessmentAttempt {
  id              String    @id @default(cuid())
  userId          String
  questionnaireId String
  status          String    @default("IN_PROGRESS")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire        @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  responses     AssessmentResponse[]

  @@unique([userId, questionnaireId])
}

model AssessmentResponse {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  domainId   String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  domain   AssessmentDomain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
